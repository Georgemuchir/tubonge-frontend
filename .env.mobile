# ── Server URLs ──────────────────────────────────────────────────────────────
# Primary: your home server, reachable only over Tailscale. Fallback: Render
# PRODUCTION — same backend + database the web app uses. This was pointed at
# Render staging before, which deploys from a separate branch that's months
# behind main (different code, different — and now differently-migrated —
# database). That meant anything sent while the mobile app had fallen back
# off the home server was invisible to the web app and vice versa: not a
# sync delay, two genuinely different data stores. Falling back to
# production instead keeps mobile and web on the same data no matter which
# one is actually serving a given request.
VITE_PRIMARY_API_URL=http://100.99.81.54:5000/api
VITE_PRIMARY_SOCKET_URL=http://100.99.81.54:5000
VITE_FALLBACK_API_URL=https://pinglo-backend.onrender.com/api
VITE_FALLBACK_SOCKET_URL=https://pinglo-backend.onrender.com

# Legacy keys kept for any direct consumers of VITE_API_URL / VITE_SOCKET_URL
VITE_API_URL=https://pinglo-backend.onrender.com/api
VITE_SOCKET_URL=https://pinglo-backend.onrender.com

# ── App ───────────────────────────────────────────────────────────────────────
VITE_APP_NAME=Tubonge
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=mobile

# ── Firebase ──────────────────────────────────────────────────────────────────
# Must be "pinglo-staging" — that's the project every backend (home server,
# Render production, Render staging) actually verifies ID tokens against.
# The repo's .env.production file references a different, unused project
# ("pinglo-b9fa3") that no backend accepts; pulled these from the real
# deployed pinglo-frontend static site's env vars instead.
VITE_FIREBASE_API_KEY=AIzaSyDNbCS6-aB9M80VDlOHSctni4QczCUIK-Y
VITE_FIREBASE_AUTH_DOMAIN=pinglo-staging.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=pinglo-staging
VITE_FIREBASE_STORAGE_BUCKET=pinglo-staging.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=410654652593
VITE_FIREBASE_APP_ID=1:410654652593:web:3af8961cbaef4db5324a90
VITE_FIREBASE_MEASUREMENT_ID=G-FS4EE059V3

# ── Feature Flags ─────────────────────────────────────────────────────────────
VITE_ENABLE_FILE_UPLOAD=true
VITE_ENABLE_VOICE_MESSAGES=true
VITE_ENABLE_VIDEO_CALLS=true
