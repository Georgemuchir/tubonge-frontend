<?xml version="1.0" encoding="utf-8"?>
<!--
  Android blocks plain HTTP by default (API 28+). The home-server backend
  (see .env.mobile) is only reachable over Tailscale and doesn't have TLS,
  so it needs an explicit cleartext exception — scoped to just that host,
  not a blanket allow, so nothing else in the app can be downgraded to HTTP.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">100.99.81.54</domain>
    </domain-config>
</network-security-config>
