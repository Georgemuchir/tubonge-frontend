# ── Server URLs ──────────────────────────────────────────────────────────────
# Primary: tried first on startup and every request.
# Fallback: auto-switched to when primary is unreachable.
#
# This build is served by nginx on the home server, which also proxies /api
# and /socket.io on that same origin (see the "pinglo" nginx site config) —
# so the primary is just a relative, same-origin path. No hostname/DNS to
# get right or keep in sync, and it sidesteps the still-broken custom domain
# entirely. Render stays configured as fallback for when the home server is
# down, but was WRONGLY set as primary before — meaning every web page load
# was eating Render free-tier's ~30s cold-start spin-up before anything else
# could happen. That, not any one feature, was most of "the app is slow".
VITE_PRIMARY_API_URL=/api
VITE_PRIMARY_SOCKET_URL=/
VITE_FALLBACK_API_URL=https://pinglo-backend.onrender.com/api
VITE_FALLBACK_SOCKET_URL=https://pinglo-backend.onrender.com

# Legacy keys kept for any direct consumers of VITE_API_URL / VITE_SOCKET_URL
VITE_API_URL=https://pinglo-backend.onrender.com/api
VITE_SOCKET_URL=https://pinglo-backend.onrender.com

# ── App ───────────────────────────────────────────────────────────────────────
VITE_APP_NAME=Tubonge
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=production

# ── Firebase (production project) ────────────────────────────────────────────
VITE_FIREBASE_API_KEY=AIzaSyAyMsi5GNr_xVWlp6OmK90_NrR_LSUdFOE
VITE_FIREBASE_AUTH_DOMAIN=pinglo-b9fa3.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://pinglo-b9fa3-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=pinglo-b9fa3
VITE_FIREBASE_STORAGE_BUCKET=pinglo-b9fa3.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=72066337696
VITE_FIREBASE_APP_ID=1:72066337696:web:90c63e4a69f54debe8f2c5
VITE_FIREBASE_MEASUREMENT_ID=G-E3LP9L50SX

# ── Feature Flags ─────────────────────────────────────────────────────────────
VITE_ENABLE_FILE_UPLOAD=true
VITE_ENABLE_VOICE_MESSAGES=true
VITE_ENABLE_VIDEO_CALLS=true
