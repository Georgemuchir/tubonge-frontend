# Pinglo Frontend - Production Environment Variables
# Copy this to .env.production and configure for production deployment

# Production Backend URLs
VITE_API_URL=https://pinglo-backend.onrender.com/api
VITE_SOCKET_URL=https://pinglo-backend.onrender.com

# App Configuration
VITE_APP_NAME=Pinglo
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=production

# Analytics (Optional - add your tracking IDs)
VITE_GA_TRACKING_ID=
VITE_SENTRY_DSN=

# Feature Flags
VITE_ENABLE_FILE_UPLOAD=false
VITE_ENABLE_VOICE_MESSAGES=false
VITE_ENABLE_VIDEO_CALLS=false

# UI Configuration
VITE_DEFAULT_THEME=light
VITE_MAX_MESSAGE_LENGTH=1000