# Pinglo Frontend - Staging Environment Variables
# Copy this to .env.staging and configure for staging deployment

# Staging Backend URLs
VITE_API_URL=https://pinglo-backend-staging.onrender.com/api
VITE_SOCKET_URL=https://pinglo-backend-staging.onrender.com

# App Configuration
VITE_APP_NAME=Pinglo
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=staging

# Analytics (Optional - add your tracking IDs)
VITE_GA_TRACKING_ID=
VITE_SENTRY_DSN=

# Feature Flags
VITE_ENABLE_FILE_UPLOAD=false
VITE_ENABLE_VOICE_MESSAGES=false
VITE_ENABLE_VIDEO_CALLS=false
